# Copy to .env.local and adjust.

# Base URL of the Shadowline FastAPI backend (no trailing slash).
# Local: http://127.0.0.1:8000   Production (Vercel): your Render URL, e.g. https://shadowline-api.onrender.com
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Optional: the public site URL, used for absolute Open Graph image links.
# On Vercel this falls back to the production domain automatically.
# NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app
